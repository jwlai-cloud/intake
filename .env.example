# IMPORTANT: if your shell exports GOOGLE_APPLICATION_CREDENTIALS (a service
# account key file), it overrides `gcloud auth application-default login` and
# every call authenticates as that service account — against whichever project
# owns it. Unset it in any terminal running Intake:
#     unset GOOGLE_APPLICATION_CREDENTIALS
# Vertex AI, not AI Studio. ADK reads this to pick the backend.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash

# Firestore. Unset GOOGLE_CLOUD_PROJECT or set INTAKE_STORE=memory to run
# without a database — the service falls back to an in-process store.
FIRESTORE_DATABASE=(default)
# INTAKE_STORE=memory

# Shared secret for the HTTP API. Unset means ungated, which is fine locally
# and is not fine on Cloud Run: every endpoint spends money on Vertex AI.
# INTAKE_API_KEY=
INTAKE_ALLOWED_ORIGINS=http://localhost:5173
