  "cards": [
    {
      "dot": "emerald",
      "title": "The differentiator",
      "items": [
        "Competitors tick an item when it is mentioned",
        "Intake ticks only when the guidance is satisfied",
        "\"A couple of wobbles\" stays open; \"three falls, the last in May\" closes"
      ]
    },
    {
      "dot": "cyan",
      "title": "Bounded by design",
      "items": [
        "Slot state is the state, not the transcript (ADR-0002)",
        "Coach reads a brief of open items, never a running transcript",
        "A three-hour interview costs the same per chunk as a ten-minute one"
      ]
    },
    {
      "dot": "amber",
      "title": "Measured, not assumed",
      "items": [
        "47 labelled cases \u00b7 46/47 \u00b7 precision on sufficient 100%",
        "Behavioural eval over the pipeline: 6 cases, 18/18 metrics at 1.00",
        "Every eval metric is deterministic code \u2014 no LLM judge, no judge bill",
        "101 backend tests, no network"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure is designed for",
      "items": [
        "Failed chunk POSTs queue locally and replay in order",
        "A replayed sequence number is a no-op",
        "One item's failure leaves it open; its neighbours still land",
        "/health reports 503 if the session store silently degraded to memory"
      ]
    }
  ]
