        "id": "two-stores",
        "label": "Two kinds of state",
        "focus": [
          "turnrunner",
          "adksession",
          "pipeline",
          "firestore"
        ],
        "note": "ADK's session service holds one turn of scratch. Durable domain state is ours, so an instance can die mid-interview and cost nothing."
      },
      {
        "id": "tooling",
        "label": "The second entrypoint",
        "focus": [
          "evaltools",
          "rootagent",
          "pipeline"
        ],
        "note": "ADK tooling discovers a module-level root_agent wired to an in-memory store, so evaluation can never write to the interview database."
      }
    ]
