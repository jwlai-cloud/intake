  "cards": [
    {
      "dot": "emerald",
      "title": "Bounded by design",
      "items": [
        "Chunked HTTP, not bidirectional streaming",
        "Each call sees open items only, never the transcript",
        "A three-hour interview costs the same per chunk as a ten-minute one"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two runners, two stores",
      "items": [
        "An ADK agent may have exactly one parent, so stages are factories",
        "ADK session state is scratch, discarded after each turn",
        "Slot state is ours in Firestore and survives an instance recycling"
      ]
    },
    {
      "dot": "rose",
      "title": "Evaluation cannot touch production",
      "items": [
        "ADK tooling discovers root_agent, not the service pipeline",
        "That entrypoint is wired to an in-memory store",
        "api_server serves apps by directory name, not by path"
      ]
    }
  ]
